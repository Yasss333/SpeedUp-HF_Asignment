APP_NAME=PA AI Email Dashboard
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Uncomment after starting MongoDB or providing an Atlas connection string.
# MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=pa_ai_email_dashboard
# AI triage uses Agno through OpenRouter. Set your key in .env only.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Demo sessions expire after 24 hours. Disable anonymous demo login in production.
DEMO_ENABLED=true
# GOOGLE_API_KEY=
